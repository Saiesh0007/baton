# Copy to .env.local and fill in. Every key is optional: without them Baton runs with the rules
# proposer and browser-only handovers (the demo works with no keys at all).

# LLM claim proposer (free key from https://console.groq.com). Server-side only.
GROQ_API_KEY=

# Shared handovers (Supabase project: Settings -> API Keys).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-side only: used by api/publish and api/propose to check membership. Never expose it.
SUPABASE_SECRET_KEY=sb_secret_...

# Only for applying migrations with psql (Settings -> Database -> Connection string -> Session pooler).
DATABASE_POOLER_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
